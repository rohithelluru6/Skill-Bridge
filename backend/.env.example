# Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
JWT_SECRET=super_secret_skill_bridge_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration
# Direct PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillbridge
# If PostgreSQL is not reachable, Skill Bridge automatically and seamlessly falls back
# to the local embedded database (skillbridge.db) with the exact same schema & sample seed data.

# AI Integration
# Set your Gemini or OpenAI API key here.
# If omitted, Skill Bridge operates in intelligent built-in Rule-Based Engine mode
# with transparent badges, detailed analytics, and full functionality.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini # or openai
