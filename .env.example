# Skill Bridge – Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0

# JWT Security
JWT_SECRET=super_secret_skill_bridge_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration
# Direct PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillbridge
# If PostgreSQL is not installed or unreachable, Skill Bridge automatically falls back
# to the high-performance local embedded database (skillbridge.db) with the exact same
# schema, tables, foreign keys, and seed data.

# AI Integration
# Set your Google Gemini or OpenAI API Key below:
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini # or openai
